# Staff screen PIN (required in production)
ADMIN_PIN=change-me
# Random string used to sign the admin cookie (optional, falls back to PIN)
ADMIN_SECRET=
# Neon Postgres connection string (if empty, orders go to a local JSON file: dev only)
DATABASE_URL=
# Optional: Telegram alert on every new order
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
